# =============================================================================
# SECURITY & MONITORING
# =============================================================================

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_REQUESTS_PER_HOUR=1000

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8090

# Monitoring
SENTRY_DSN=your-sentry-dsn
SENTRY_ENVIRONMENT=development

# =============================================================================
# DEVELOPMENT FLAGS
# =============================================================================

# Feature Flags
ENABLE_DEBUG_MODE=true
ENABLE_MOCK_DATA=true
ENABLE_API_LOGGING=true
ENABLE_PERFORMANCE_MONITORING=true

# Development Database Seeding
SEED_SAMPLE_DATA=true
SEED_TEST_USERS=true
SEED_SAMPLE_PROJECTS=true

# =============================================================================
# TESTING CONFIGURATION
# =============================================================================

# Test Database
TEST_DATABASE_URL=postgresql://postgres:your-super-secret-and-long-postgres-password@localhost:5432/plotops_test

# Test API Keys (use test/sandbox keys)
TEST_GOOGLE_MAPS_API_KEY=your-test-google-maps-api-key
