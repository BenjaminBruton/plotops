API_EXTERNAL_URL=http://localhost:8000
PUBLIC_REST_URL=http://localhost:8000/rest/v1/
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=http://localhost:3000,http://localhost:3001

# Auth Settings
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_ANONYMOUS_USERS=false
ENABLE_EMAIL_AUTOCONFIRM=true

# PostgREST
PGRST_DB_SCHEMAS=public,auth,storage,graphql_public

# Email Configuration (SMTP)
SMTP_ADMIN_EMAIL=admin@plotops.dev
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=PlotOps

# Mailer URL Paths
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

# Analytics
LOGFLARE_API_KEY=your-super-secret-logflare-api-key

# Functions
FUNCTIONS_VERIFY_JWT=false

# Image Proxy
IMGPROXY_ENABLE_WEBP_DETECTION=true

# =============================================================================
# N8N WORKFLOW AUTOMATION
# =============================================================================
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=plotops123
N8N_ENCRYPTION_KEY=your-super-secret-n8n-encryption-key-32-chars

# N8N Database
N8N_DB_NAME=n8n
N8N_DB_USER=n8n_user
N8N_DB_PASSWORD=n8n_password

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_PASSWORD=plotops-redis-password
REDIS_URL=redis://:plotops-redis-password@localhost:6379

# =============================================================================
# MINIO S3 STORAGE
# =============================================================================
MINIO_ROOT_USER=plotops
MINIO_ROOT_PASSWORD=plotops123
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET_NAME=plotops-dev

# =============================================================================
# DEVELOPMENT TOOLS
# =============================================================================

# PgAdmin
PGADMIN_EMAIL=admin@plotops.dev
PGADMIN_PASSWORD=plotops123

# Redis Commander
REDIS_COMMANDER_USER=admin
REDIS_COMMANDER_PASSWORD=plotops123

# =============================================================================
# EXTERNAL APIS
# =============================================================================

# Google Maps API
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# Weather API (OpenWeatherMap)
